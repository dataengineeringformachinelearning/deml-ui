{
  "name": "deml-ui",
  "version": "1.0.0",
  "description": "deml-ui — DEML component library with HTML/CSS sources, Web Components, and Angular builds.",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/web-components/deml-ui.js",
    "./dist/web-components/deml-ui.iife.js",
    "./src/web-components/index.ts"
  ],
  "main": "./dist/web-components/deml-ui.js",
  "module": "./dist/web-components/deml-ui.js",
  "types": "./dist/web-components/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/web-components/index.d.ts",
      "import": "./dist/web-components/deml-ui.js",
      "default": "./dist/web-components/deml-ui.js"
    },
    "./styles.css": "./dist/styles/deml-ui.css",
    "./tokens.css": "./dist/styles/tokens.css",
    "./angular": {
      "types": "./dist/angular/index.d.ts",
      "default": "./dist/angular/fesm2022/deml-ui.mjs"
    },
    "./html/*": "./dist/html/*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "dev": "vite",
    "start": "vite",
    "storybook": "npm run sync && storybook dev -p 6006",
    "storybook:gen": "node scripts/generate-stories.mjs",
    "build-storybook": "npm run sync && storybook build -o storybook-static",
    "build:styles": "node scripts/build-styles.mjs",
    "build:wc": "vite build --config vite.lib.config.ts && node scripts/write-wc-types.mjs",
    "build:html": "node scripts/build-html.mjs",
    "build:angular": "node scripts/build-angular.mjs",
    "build": "node scripts/build-all.mjs",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dataengineeringformachinelearning/deml-ui.git"
  },
  "bugs": {
    "url": "https://github.com/dataengineeringformachinelearning/deml-ui/issues"
  },
  "keywords": [
    "design-system",
    "component-library",
    "web-components",
    "custom-elements",
    "angular",
    "html",
    "css",
    "storybook",
    "deml"
  ],
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/dataengineeringformachinelearning/deml-ui#readme",
  "peerDependencies": {
    "@angular/common": ">=19.0.0",
    "@angular/core": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^19.2.14",
    "@angular/compiler": "^19.2.14",
    "@angular/compiler-cli": "^19.2.14",
    "@angular/core": "^19.2.14",
    "@storybook/addon-a11y": "^10.5.4",
    "@storybook/addon-docs": "^10.5.4",
    "@storybook/html-vite": "^10.5.4",
    "ng-packagr": "^19.2.2",
    "rxjs": "^7.8.2",
    "storybook": "^10.5.4",
    "tslib": "^2.8.1",
    "typescript": "~5.8.3",
    "vite": "^8.1.5",
    "zone.js": "^0.15.1"
  }
}
